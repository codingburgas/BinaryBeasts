#include "presentation.h"
#include "raylib.h"
#include "logic.h"
#include <ctime>
#include <cstdlib>

void run_app() {
    InitWindow(900, 600, "Sports Manager Pro - FINAL VERSION");
    SetTargetFPS(60);
    srand((unsigned int)time(NULL));

    std::vector<Team> teams = load_data();

    // Начални данни, ако файлът е празен
    if (teams.empty()) {
        add_team_logic(teams, "Real Madrid");
        add_team_logic(teams, "FC Barcelona");
        add_team_logic(teams, "Manchester City");
    }

    std::vector<Match> matches = { {2, 1}, {3, 2}, {0, 1} };
    char inputBuf[50] = "\0";
    int letterCount = 0;
    bool showAddModal = false;
    bool inputActive = false;

    while (!WindowShouldClose()) {
        // Handle modal input
        if (showAddModal) {
            int key = GetCharPressed();
            while (key > 0) {
                if (inputActive && letterCount < 49 && key >= 32 && key <= 125) {
                    inputBuf[letterCount] = (char)key;
                    inputBuf[letterCount + 1] = '\0';
                    letterCount++;
                }
                key = GetCharPressed();
            }
            if (inputActive && IsKeyPressed(KEY_BACKSPACE) && letterCount > 0) inputBuf[--letterCount] = '\0';
            if (inputActive && IsKeyPressed(KEY_ENTER) && letterCount > 0) {
                add_team_logic(teams, inputBuf);
                inputBuf[0] = '\0'; letterCount = 0;
                showAddModal = false;
                inputActive = false;
            }
            if (IsKeyPressed(KEY_ESCAPE)) {
                showAddModal = false;
                inputActive = false;
            }
        } else {
            if (IsKeyPressed(KEY_F1) && teams.size() > 1) quick_sort_teams(teams, 0, (int)teams.size() - 1);
            if (IsKeyPressed(KEY_F2)) delete_last_team_logic(teams);
            if (IsKeyPressed(KEY_F3)) clear_all_teams_logic(teams);
        }

        BeginDrawing();
        ClearBackground(GetColor(0x181C24FF));

        // Sidebar
        DrawRectangleRounded(Rectangle{0, 0, 180, 600}, 0.08f, 8, GetColor(0x232946FF));
        DrawText("MENU", 30, 30, 28, WHITE);

        // Sidebar buttons
        int btnY = 90;
        int btnH = 48;
        Color btnColor = GetColor(0x393E46FF);
        Color btnHover = GetColor(0x4ECCA3FF);
        Vector2 mouse = GetMousePosition();

        // Add Team Button
        Rectangle addBtn = Rectangle{30, (float)btnY, 120, (float)btnH};
        bool addHover = CheckCollisionPointRec(mouse, addBtn);
        DrawRectangleRounded(addBtn, 0.18f, 8, addHover ? btnHover : btnColor);
        DrawText("Add Team", 45, btnY + 13, 20, WHITE);
        if (!showAddModal && IsMouseButtonPressed(MOUSE_LEFT_BUTTON) && addHover) {
            showAddModal = true;
            inputActive = true;
        }
        btnY += btnH + 18;

        // Sort Button
        Rectangle sortBtn = Rectangle{30, (float)btnY, 120, (float)btnH};
        bool sortHover = CheckCollisionPointRec(mouse, sortBtn);
        DrawRectangleRounded(sortBtn, 0.18f, 8, sortHover ? btnHover : btnColor);
        DrawText("Sort", 75, btnY + 13, 20, WHITE);
        if (!showAddModal && IsMouseButtonPressed(MOUSE_LEFT_BUTTON) && sortHover && teams.size() > 1) {
            quick_sort_teams(teams, 0, (int)teams.size() - 1);
        }
        btnY += btnH + 18;

        // Delete Last Button
        Rectangle delBtn = Rectangle{30, (float)btnY, 120, (float)btnH};
        bool delHover = CheckCollisionPointRec(mouse, delBtn);
        DrawRectangleRounded(delBtn, 0.18f, 8, delHover ? btnHover : btnColor);
        DrawText("Delete Last", 38, btnY + 13, 20, WHITE);
        if (!showAddModal && IsMouseButtonPressed(MOUSE_LEFT_BUTTON) && delHover) {
            delete_last_team_logic(teams);
        }
        btnY += btnH + 18;

        // Clear All Button
        Rectangle clrBtn = Rectangle{30, (float)btnY, 120, (float)btnH};
        bool clrHover = CheckCollisionPointRec(mouse, clrBtn);
        DrawRectangleRounded(clrBtn, 0.18f, 8, clrHover ? btnHover : btnColor);
        DrawText("Clear All", 52, btnY + 13, 20, WHITE);
        if (!showAddModal && IsMouseButtonPressed(MOUSE_LEFT_BUTTON) && clrHover) {
            clear_all_teams_logic(teams);
        }

        // Main content area
        DrawRectangleRounded(Rectangle{190, 20, 680, 520}, 0.06f, 8, GetColor(0x232946FF));
        DrawText("LEAGUE STANDINGS", 220, 40, 32, WHITE);

        // Team list header
        DrawText("Team", 220, 90, 22, LIGHTGRAY);
        DrawText("Points", 600, 90, 22, LIGHTGRAY);
        DrawText("Goals", 700, 90, 22, LIGHTGRAY);

        // Team list
        for (int i = 0; i < (int)teams.size(); i++) {
            int y = 120 + (i * 48);
            Color rowColor = (i % 2 == 0) ? GetColor(0x393E46FF) : GetColor(0x232946FF);
            DrawRectangleRounded(Rectangle{200, (float)y, 650, 40}, 0.18f, 8, rowColor);
            // Avatar (circle with initials)
            DrawCircle(225, y + 20, 18, GetColor(0x4ECCA3FF));
            char initials[3] = {0};
            initials[0] = teams[i].name[0];
            for (int j = 1, k = 1; teams[i].name[j] != '\0' && k < 2; j++) {
                if (teams[i].name[j-1] == ' ' && teams[i].name[j] != ' ') {
                    initials[k++] = teams[i].name[j];
                }
            }
            DrawText(initials, 218, y + 10, 18, DARKBLUE);
            // Team name
            DrawText(teams[i].name, 260, y + 12, 20, RAYWHITE);
            // Points
            DrawText(TextFormat("%d", teams[i].points), 620, y + 12, 20, GOLD);
            // Goals
            DrawText(TextFormat("%d", teams[i].goalsScored), 720, y + 12, 20, SKYBLUE);
        }

        // Footer
        DrawRectangleRounded(Rectangle{190, 550, 680, 40}, 0.10f, 8, GetColor(0x393E46FF));
        int totalGoals = calculate_total_goals_recursive(matches, (int)matches.size());
        DrawText(TextFormat("Total Goals: %d", totalGoals), 210, 560, 20, GREEN);
        DrawText("ESC to exit | F1:Sort F2:Del F3:Clear", 600, 560, 16, LIGHTGRAY);

        // Add Team Modal
        if (showAddModal) {
            DrawRectangle(0, 0, 900, 600, Fade(BLACK, 0.5f));
            DrawRectangleRounded(Rectangle{300, 200, 320, 180}, 0.18f, 8, GetColor(0x232946FF));
            DrawText("Add New Team", 370, 220, 24, WHITE);
            DrawRectangleRounded(Rectangle{340, 270, 240, 40}, 0.18f, 8, inputActive ? SKYBLUE : DARKGRAY);
            DrawText(inputBuf, 350, 280, 22, WHITE);
            DrawText("Press ENTER to add, ESC to cancel", 320, 330, 18, LIGHTGRAY);
            if (CheckCollisionPointRec(mouse, Rectangle{340, 270, 240, 40}) && IsMouseButtonPressed(MOUSE_LEFT_BUTTON)) {
                inputActive = true;
            }
        }

        EndDrawing();
    }
    save_data(teams);
    CloseWindow();
}